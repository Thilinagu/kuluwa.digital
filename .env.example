# --- Database ---
# PostgreSQL connection string (e.g. from Supabase, Neon, or Railway)
DATABASE_URL="postgresql://user:password@host:5432/kuluwa_digital"

# --- Site ---
NEXT_PUBLIC_SITE_URL="https://kuluwa.digital"

# --- Email delivery (Resend) ---
# Create a free account at https://resend.com, verify your sending domain,
# and generate an API key. Every form submission is emailed to ADMIN_EMAIL.
RESEND_API_KEY=""
EMAIL_FROM="Kuluwa.digital <notifications@kuluwa.digital>"
ADMIN_EMAIL="gtmgunasekara@gmail.com"

# --- Spam protection (Cloudflare Turnstile) ---
# Create a site at https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Analytics (added once accounts exist) ---
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
