// Kuluwa.digital — Prisma schema
// Covers the data the current website actually needs (form submissions).
// Lead/Partner/Commission models are included as forward-looking architecture
// for the future partner network platform described in the project brief —
// clearly separated below — but are not yet wired to any UI.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// LIVE MODELS — used by the current contact / enquiry / application forms
// ------------------------------------------------------------------

enum SubmissionStatus {
  NEW
  REVIEWED
  CONTACTED
  CLOSED
}

model ContactSubmission {
  id        String           @id @default(cuid())
  reference String           @unique
  name      String
  email     String
  phone     String?
  enquiryType String
  subject   String
  message   String
  consent   Boolean          @default(false)
  status    SubmissionStatus @default(NEW)
  emailedAt DateTime?
  createdAt DateTime         @default(now())
}

model ProjectInquiry {
  id               String           @id @default(cuid())
  reference        String           @unique
  name             String
  company          String?
  email            String
  phone            String
  country          String?
  projectType      String
  industry         String?
  projectTitle     String
  description      String
  mainProblem      String
  desiredFeatures  String?
  budgetRange      String?
  timeline         String?
  existingUrl      String?
  preferredContact String?
  source           String?
  consent          Boolean          @default(false)
  status           SubmissionStatus @default(NEW)
  emailedAt        DateTime?
  createdAt        DateTime         @default(now())
}

model Application {
  id                 String           @id @default(cuid())
  reference          String           @unique
  name               String
  email              String
  phone              String
  district           String
  city               String?
  preferredContact   String?
  currentStatus      String?
  yearsExperience    String?
  occupation         String?
  education          String?
  linkedinUrl        String?
  portfolioUrl       String?
  interestedRoles    String[]
  technicalSkills    String?
  businessExperience String?
  languages          String?
  availability       String?
  whyJoin            String
  valueOffered       String?
  story              String?
  consentReview      Boolean          @default(false)
  consentAccurate    Boolean          @default(false)
  status             SubmissionStatus @default(NEW)
  emailedAt          DateTime?
  createdAt          DateTime         @default(now())
}

// ------------------------------------------------------------------
// FUTURE ARCHITECTURE — partner network platform (Section 13/14 of the
// brief). Modeled now so migrations are additive later; not exposed in
// any current page or API route.
// ------------------------------------------------------------------

enum LeadStatus {
  SUBMITTED
  REVIEWED
  QUALIFIED
  CONTACTED
  PROPOSAL_SENT
  WON
  LOST
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  VOID
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  createdAt DateTime @default(now())
  leads       Lead[]
  commissions Commission[]
}

model Lead {
  id          String     @id @default(cuid())
  reference   String     @unique
  partnerId   String?
  partner     Partner?   @relation(fields: [partnerId], references: [id])
  clientName  String
  clientEmail String?
  clientPhone String?
  description String
  status      LeadStatus @default(SUBMITTED)
  projectId   String?
  createdAt   DateTime   @default(now())
  commissions Commission[]
}

model Commission {
  id        String            @id @default(cuid())
  partnerId String
  partner   Partner           @relation(fields: [partnerId], references: [id])
  leadId    String
  lead      Lead              @relation(fields: [leadId], references: [id])
  amount    Decimal?          @db.Decimal(12, 2)
  status    CommissionStatus  @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime          @default(now())
}
